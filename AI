# =====================================================================
# FUNÇÃO PARA INSTALAR WINGET
# =====================================================================

function Install-WingetApp {

    param(
        [Parameter(Mandatory = $true)]
        [string]$Id
    )

    Write-Status `
        "Instalando: $Id" `
        Cyan

    try {

        & winget install `
            --id $Id `
            -e `
            --silent `
            --accept-package-agreements `
            --accept-source-agreements `
            --disable-interactivity

        $ExitCode = $LASTEXITCODE

        if ($ExitCode -eq 0) {

            Write-Status `
                "OK: $Id" `
                Green

            return $true
        }

        Write-Status `
            "FALHA: $Id | Código: $ExitCode" `
            Red

        return $false
    }
    catch {

        Write-Status `
            "ERRO: $Id" `
            Red

        Write-Host `
            $_.Exception.Message `
            -ForegroundColor Red

        return $false
    }
}

