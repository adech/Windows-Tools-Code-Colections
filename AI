try {

    if (-not (
        Get-Module `
            -ListAvailable `
            -Name PSWindowsUpdate
    )) {

        Write-Status `
            "Instalando PSWindowsUpdate..." `
            Yellow

        Install-Module `
            -Name PSWindowsUpdate `
            -Force `
            -Confirm:$false `
            -AllowClobber `
            -ErrorAction Stop
    }

    Import-Module `
        PSWindowsUpdate `
        -Force

    Write-Status `
        "Procurando atualizações do Windows..." `
        Yellow

    Get-WindowsUpdate

    Write-Host ""

    Write-Status `
        "Instalando atualizações..." `
        Yellow

    Get-WindowsUpdate `
        -Install `
        -AcceptAll `
        -IgnoreReboot `
        -Confirm:$false

    Write-Status `
        "Windows Update concluído." `
        Green
}
catch {

    Write-Status `
        "Windows Update encontrou um problema." `
        Yellow

    Write-Host `
        $_.Exception.Message `
        -ForegroundColor Yellow
}

# =====================================================================
# LIMPEZA
# =====================================================================

Write-Host ""

Write-Status `
    "Limpando arquivos temporários do processo..." `
    Yellow

try {

    if (Test-Path $OfficeDir) {

        Remove-Item `
            $OfficeDir `
            -Recurse `
            -Force `
            -ErrorAction SilentlyContinue
    }

    Write-Status `
        "Limpeza concluída." `
        Green
}
catch {

    Write-Status `
        "Alguns arquivos temporários permaneceram." `
        Yellow
}

# =====================================================================
# RESUMO FINAL
# =====================================================================

Write-Host ""

Write-Status `
    "============================================" `
    Green

Write-Status `
    "             RESUMO FINAL" `
    Green

Write-Status `
    "============================================" `
    Green

Write-Host ""

# =====================================================================
# PROGRAMAS OK
# =====================================================================

Write-Status `
    "PROGRAMAS INSTALADOS COM SUCESSO:" `
    Green

foreach ($Item in $Success) {

    Write-Host `
        "  [OK] $Item" `
        -ForegroundColor Green
}

# =====================================================================
# PROGRAMAS COM FALHA
# =====================================================================

Write-Host ""

if ($Failed.Count -gt 0) {

    Write-Status `
        "PROGRAMAS COM FALHA:" `
        Red

    foreach ($Item in $Failed) {

        Write-Host `
            "  [ERRO] $Item" `
            -ForegroundColor Red
    }
}
else {

    Write-Status `
        "Nenhum programa apresentou falha." `
        Green
}

# =====================================================================
# TOTAIS
# =====================================================================

Write-Host ""

Write-Status `
    "Total OK    : $($Success.Count)" `
    Green

Write-Status `
    "Total Falha : $($Failed.Count)" `
    Red

Write-Host ""

# =====================================================================
# OFFICE
# =====================================================================

if ($OfficeInstalled) {

    Write-Status `
        "Office instalado: SIM" `
        Green

    Write-Status `
        "Office LTSC Professional Plus 2024" `
        Green
}
else {

    Write-Status `
        "Office instalado: NÃO CONFIRMADO" `
        Red
}

# =====================================================================
# RETROARCH
# =====================================================================

Write-Host ""

$RetroArchInstalled = $false

$RetroArchPaths = @(

    "$env:LOCALAPPDATA\Programs\RetroArch\retroarch.exe",

    "$env:ProgramFiles\RetroArch\retroarch.exe",

    "${env:ProgramFiles(x86)}\RetroArch\retroarch.exe"
)

foreach ($RetroPath in $RetroArchPaths) {

    if (Test-Path $RetroPath) {

        $RetroArchInstalled = $true

        Write-Status `
            "RetroArch: INSTALADO" `
            Green

        break
    }
}

if (-not $RetroArchInstalled) {

    Write-Status `
        "RetroArch: verificar pelo Winget/Aplicativos instalados." `
        Yellow
}

# =====================================================================
# LOGS
# =====================================================================

Write-Host ""

Write-Status `
    "Log principal:" `
    Cyan

Write-Host `
    $LogFile `
    -ForegroundColor White

Write-Status `
    "Log específico do Office:" `
    Cyan

Write-Host `
    $OfficeLogFile `
    -ForegroundColor White

# =====================================================================
# FINAL
# =====================================================================

Write-Host ""

Write-Status `
    "============================================" `
    Green

Write-Status `
    "      POWERSHELL MASTER FINALIZADO" `
    Green

Write-Status `
    "============================================" `
    Green

Write-Host ""

Write-Status `
    "Recomenda-se reiniciar o computador." `
    Yellow

Write-Host ""

try {
    Stop-Transcript | Out-Null
}
catch {}

Write-Host ""

Write-Host `
    "Pressione ENTER para fechar..." `
    -ForegroundColor Yellow

Read-Host
