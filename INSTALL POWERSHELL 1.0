$apps = @(
    @{ Name = "HandBrake";       Id = "HandBrake.HandBrake" },
    @{ Name = "Shutter Encoder"; Id = "PaulPacifico.ShutterEncoder" },
    @{ Name = "FFmpeg";          Id = "Gyan.FFmpeg" },
    @{ Name = "Parabolic";       Id = "Nickvision.Parabolic" },
    @{ Name = "yt-dlp";          Id = "yt-dlp.yt-dlp" },
    @{ Name = "yt-dlg";          Id = "yt-dlg.yt-dlg" }
)

$total =$apps.Count
$index = 0

foreach ($app in $apps) {$percent = [math]::Round(($index / $total) * 100)
    
    Write-Progress -Activity "Instalando Conversores e Downloaders" -Status "$($app.Name) ($($index + 1) de $total)" -PercentComplete $percent
    Write-Host "`n>>> Iniciando instalação: $($app.Name)..." -ForegroundColor Cyan

    winget install --id $app.Id --exact --accept-package-agreements --accept-source-agreements

    $index++
    Start-Sleep -Seconds 1
}

Write-Progress -Activity "Instalando Conversores e Downloaders" -Completed
Write-Host "`nInstalações concluídas com sucesso!" -ForegroundColor Green
