$total =$apps.Count
$index = 0

foreach ($app in $apps) {$percent = [math]::Round(($index / $total) * 100)

    Write-Progress -Activity "Instalação em Lote de Aplicativos" `
                   -Status "$($app.Name) ($($index + 1) de $total)" `
                   -PercentComplete $percent

    Write-Host "`n>>> Instalando: $($app.Name)..." -ForegroundColor Cyan

    winget install --id $app.Id --exact --accept-package-agreements --accept-source-agreements --silent

    $index++
    Start-Sleep -Seconds 1
}

Write-Progress -Activity "Instalação em Lote de Aplicativos" -Completed
Write-Host "`nTodos os aplicativos selecionados foram processados!" -ForegroundColor Green
